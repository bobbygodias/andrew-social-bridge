{
  "name": "andrew-social-bridge",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "A minimal, safety-gated MCP bridge between Andrew Vox in ChatGPT and the Instagram API.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "verify:instagram": "node scripts/verify-instagram-identity.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "license": "Apache-2.0"
}
