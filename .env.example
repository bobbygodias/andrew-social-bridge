# Meta / Instagram API with Instagram Login
# Never commit or screenshot the live token. Use a host secret manager in deployment.
# Verify the API version available to your Meta app before deployment.
INSTAGRAM_API_VERSION=replace_with_version_shown_in_meta_app
INSTAGRAM_USER_ID=replace_me
INSTAGRAM_EXPECTED_USERNAME=andrewvoxai
INSTAGRAM_ACCESS_TOKEN=replace_me_in_host_secret_manager

# Public URL where this bridge is deployed
PUBLIC_BASE_URL=https://andrew-social.example.com

# Human approval boundary — generate strong random values and store only in the host secret manager.
APPROVAL_HMAC_SECRET=replace_with_at_least_32_random_characters
APPROVER_USERNAME=replace_me
APPROVER_PASSWORD=replace_with_a_long_random_password

# Must be persistent storage for replay protection. Do NOT use ephemeral serverless disk in production.
APPROVAL_STATE_DIR=.state

PORT=3000
NODE_ENV=production
